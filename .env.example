# ---------- Schedule ----------
CHECK_CRON=0 8 * * *            # node-cron syntax. "0 8 * * *" = daily 08:00 · "0 */6 * * *" = every 6 h · "0 8,18 * * 1-5" = weekdays 08:00 + 18:00
CHECK_TIMEZONE=Europe/London    # IANA zone for the schedule (default: this machine's zone)
# HEALTH_PORT=8080              # GET /health while "start" runs (Docker / UptimeRobot)

# ---------- Storage ----------
# DB_PATH=data/prices.db
DEFAULT_CURRENCY=USD            # used when a page shows a price without a currency

# ---------- Scraping ----------
ENGINE=auto                     # auto = Shopify JSON -> HTTP -> stealth Chrome · http = never launch Chrome · browser = always Chrome
CONCURRENCY=4                   # stores checked in parallel (pages of ONE store are always one at a time)
BROWSER_CONCURRENCY=2           # Chrome tabs at once
DOMAIN_DELAY_MS=3000            # gap between two pages of the same store (randomised ±30%)
REQUEST_TIMEOUT_MS=25000
RETRIES=1
RESPECT_ROBOTS=true             # set false only for sites you have permission to monitor
# PROXY_URL=http://user:pass@proxy.example.com:8000   # residential proxy for strict sites (Amazon, Best Buy...)
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe   # use an installed Chrome instead of Puppeteer's
# HEADLESS=false                # watch the browser work (debugging)
# DEBUG_SCREENSHOTS=true        # save a screenshot to data/debug/ when a browser page fails

# ---------- Alert rules ----------
# ALERT_TYPES=price_drop,sale_started,target_reached,all_time_low,undercut,back_in_stock,out_of_stock,tracker_failing,price_increase
DROP_PCT=5                      # alert when the price falls at least this % since the last check
DROP_AMOUNT=0                   # ...or by at least this amount (0 = off)
INCREASE_PCT=10                 # for price_increase (off by default; add it to ALERT_TYPES)
MIN_SALE_PCT=5                  # minimum "was/now" discount for sale_started
SUSPICIOUS_DROP_PCT=60          # drops this big are re-read before being trusted
ALERT_COOLDOWN_HOURS=20         # same alert for the same product+price is not repeated within this window
FAIL_ALERT_AFTER=3              # alert once when a product fails this many checks in a row
RUN_SUMMARY=true                # send a short summary to remote channels after every run

# ---------- Alert channels (any combination) ----------
# Telegram: create a bot with @BotFather, send it a message, then open https://api.telegram.org/bot<TOKEN>/getUpdates for the chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=               # comma separated for several chats / groups
SLACK_WEBHOOK_URL=              # https://api.slack.com/messaging/webhooks
DISCORD_WEBHOOK_URL=            # Channel settings -> Integrations -> Webhooks
RESEND_API_KEY=                 # email via https://resend.com (free tier)
ALERT_EMAIL_TO=
# ALERT_EMAIL_FROM=Price Tracker <alerts@yourdomain.com>
ALERT_WEBHOOK_URL=              # JSON to Zapier / Make / n8n / your repricer
ALERT_WEBHOOK_SECRET=           # sent as X-Price-Tracker-Secret

# ---------- Optional AI fallback (reads the price when no extractor can) ----------
# Leave all empty to run without AI. Chain order and timeouts: multi-model-fallback router in src/ai/.
GEMINI_API_KEY=            # https://aistudio.google.com/apikey
GROQ_API_KEY=              # https://console.groq.com/keys (free, very fast)
NVIDIA_API_KEY=            # https://build.nvidia.com (free credits)
OPENROUTER_API_KEY=        # https://openrouter.ai/keys (":free" models)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# AI_CHAIN=gemini:gemini-flash-latest,gemini:gemini-3.6-flash,...   (provider:model, comma separated)
AI_TIMEOUT_MS=10000        # per model, while another model is left to try
AI_TOTAL_BUDGET_MS=30000   # whole answer
AI_HEDGE_MS=6000           # start the next model in parallel if the current one is silent this long (0 = off)
# AI_EXTRACT=off
